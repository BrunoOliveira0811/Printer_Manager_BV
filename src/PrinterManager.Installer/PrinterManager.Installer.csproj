<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <AssemblyName>GestaoImpressoras-Setup</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>..\PrinterManager.App\Resources\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <InvariantGlobalization>true</InvariantGlobalization>
    <DebugType>none</DebugType>
    <!-- Sem trimming: usamos COM (WScript.Shell), Registry e ACL diretamente -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="embedded-app\GestaoImpressoras.App.exe"
                      Condition="Exists('embedded-app\GestaoImpressoras.App.exe')">
      <LogicalName>GestaoImpressoras.App.exe</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
