<Window x:Class="PrinterManager.App.Views.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Trocar senha" Style="{StaticResource AppWindow}"
        Width="380" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FocusManager.FocusedElement="{Binding ElementName=CurrentBox}">
    <StackPanel Margin="20">
        <TextBlock Text="Senha atual" Style="{StaticResource FieldLabel}" />
        <PasswordBox x:Name="CurrentBox" AutomationProperties.Name="Senha atual" />
        <TextBlock Text="Nova senha" Style="{StaticResource FieldLabel}" />
        <PasswordBox x:Name="NewBox" AutomationProperties.Name="Nova senha" />
        <TextBlock Text="Confirmar nova senha" Style="{StaticResource FieldLabel}" />
        <PasswordBox x:Name="ConfirmBox" AutomationProperties.Name="Confirmar nova senha" />
        <TextBlock x:Name="ErrorText" Foreground="{StaticResource StatusError}" TextWrapping="Wrap" Margin="0,10,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancelar" IsCancel="True" />
            <Button Content="Salvar" IsDefault="True" Style="{StaticResource PrimaryButton}" Margin="0" Click="Save_Click" />
        </StackPanel>
    </StackPanel>
</Window>
