<Window x:Class="PrinterManager.App.Views.UserEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Usuário" Style="{StaticResource AppWindow}"
        Width="420" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="20">
        <TextBlock Text="Login" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="UserNameBox" AutomationProperties.Name="Login" />
        <TextBlock Text="Nome completo" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="FullNameBox" AutomationProperties.Name="Nome completo" />
        <TextBlock Text="E-mail" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="EmailBox" AutomationProperties.Name="E-mail" />
        <TextBlock Text="Perfil de acesso" Style="{StaticResource FieldLabel}" />
        <ComboBox x:Name="RoleBox" DisplayMemberPath="Text" SelectedValuePath="Value" AutomationProperties.Name="Perfil de acesso" />
        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"
                   Text="Administrador: tudo. Técnico: cadastra, edita, reseta peças e registra manutenções. Visualizador: somente leitura." />
        <StackPanel x:Name="PasswordPanel">
            <TextBlock Text="Senha inicial" Style="{StaticResource FieldLabel}" />
            <PasswordBox x:Name="PasswordBox" AutomationProperties.Name="Senha inicial" />
            <TextBlock Text="Confirmar senha" Style="{StaticResource FieldLabel}" />
            <PasswordBox x:Name="ConfirmBox" AutomationProperties.Name="Confirmar senha" />
        </StackPanel>
        <CheckBox x:Name="ActiveBox" Content="Usuário ativo" IsChecked="True" Margin="0,10,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancelar" IsCancel="True" />
            <Button Content="Salvar" IsDefault="True" Style="{StaticResource PrimaryButton}" Margin="0" Click="Save_Click" />
        </StackPanel>
    </StackPanel>
</Window>
