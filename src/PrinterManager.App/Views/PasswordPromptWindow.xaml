<Window x:Class="PrinterManager.App.Views.PasswordPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}"
        Width="440" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="20">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,0,0,8" />
        <TextBlock Text="Usuário administrador" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="UserBox" AutomationProperties.Name="Usuário administrador" />
        <TextBlock Text="Senha" Style="{StaticResource FieldLabel}" />
        <PasswordBox x:Name="PasswordBox" AutomationProperties.Name="Senha do administrador" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancelar" IsCancel="True" />
            <Button Content="Confirmar exclusão" IsDefault="True" Style="{StaticResource DangerButton}" Margin="0" Click="Ok_Click" />
        </StackPanel>
    </StackPanel>
</Window>
