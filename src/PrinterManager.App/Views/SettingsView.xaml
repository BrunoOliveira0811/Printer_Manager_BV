<UserControl x:Class="PrinterManager.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button Content="Salvar configurações" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" />
            <TextBlock Text="{Binding Status}" VerticalAlignment="Center" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
        </DockPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <WrapPanel>
                <!-- Alertas -->
                <Border Style="{StaticResource Card}" Width="420" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="Alertas" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Nível crítico de suprimento (%)" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Settings.CriticalSupplyPercent}" AutomationProperties.Name="Nível crítico de suprimento em porcentagem" />
                        <TextBlock Text="Alerta preventivo de peça (% da vida útil)" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Settings.WearAlertPercent}" AutomationProperties.Name="Alerta de desgaste em porcentagem" />
                        <CheckBox Content="Alerta sonoro na interface" IsChecked="{Binding Settings.SoundAlerts}" Margin="0,10,0,0" />
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="Toda alteração destes parâmetros é registrada na auditoria com data e usuário." />
                    </StackPanel>
                </Border>

                <!-- Varredura -->
                <Border Style="{StaticResource Card}" Width="420" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="Varredura automática" Style="{StaticResource SectionTitle}" />
                        <CheckBox Content="Varredura automática habilitada" IsChecked="{Binding Settings.PollingEnabled}" />
                        <TextBlock Style="{StaticResource FieldLabel}">
                            Intervalo entre varreduras (minutos, mínimo <Run Text="{Binding MinPollInterval, Mode=OneWay}" />)
                        </TextBlock>
                        <TextBox Text="{Binding Settings.PollIntervalMinutes}" AutomationProperties.Name="Intervalo de varredura em minutos" />
                        <TextBlock Text="Timeout SNMP (ms)" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Settings.SnmpTimeoutMs}" AutomationProperties.Name="Timeout SNMP em milissegundos" />
                        <TextBlock Text="Consultas simultâneas" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Settings.MaxConcurrentPolls}" AutomationProperties.Name="Consultas simultâneas" />
                        <TextBlock Text="Comunidade SNMP padrão" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Settings.DefaultCommunity}" AutomationProperties.Name="Comunidade SNMP padrão" />
                    </StackPanel>
                </Border>

                <!-- E-mail -->
                <Border Style="{StaticResource Card}" Width="420" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="Notificação por e-mail" Style="{StaticResource SectionTitle}" />
                        <CheckBox Content="Enviar alertas por e-mail" IsChecked="{Binding Settings.EmailEnabled}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Servidor SMTP" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Settings.SmtpHost}" AutomationProperties.Name="Servidor SMTP" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Porta" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Settings.SmtpPort}" AutomationProperties.Name="Porta SMTP" />
                            </StackPanel>
                        </Grid>
                        <CheckBox Content="Usar SSL/TLS" IsChecked="{Binding Settings.SmtpUseSsl}" Margin="0,8,0,0" />
                        <TextBlock Text="Usuário" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Settings.SmtpUser}" AutomationProperties.Name="Usuário SMTP" />
                        <TextBlock Text="Senha" Style="{StaticResource FieldLabel}" />
                        <PasswordBox x:Name="SmtpPasswordBox" PasswordChanged="SmtpPassword_Changed" AutomationProperties.Name="Senha SMTP" />
                        <TextBlock Text="Remetente" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Settings.SmtpFrom}" AutomationProperties.Name="Remetente" />
                        <TextBlock Text="Destinatários (separados por ;)" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Settings.EmailRecipients}" AutomationProperties.Name="Destinatários" />
                        <Button Content="Enviar e-mail de teste" Command="{Binding TestEmailCommand}" HorizontalAlignment="Left" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <!-- Webhook -->
                <Border Style="{StaticResource Card}" Width="420" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="Webhooks (Teams, Slack, Service Desk)" Style="{StaticResource SectionTitle}" />
                        <CheckBox Content="Enviar alertas para webhooks" IsChecked="{Binding Settings.WebhookEnabled}" />
                        <TextBlock Text="URLs HTTPS (uma por linha)" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Settings.WebhookUrls}" AcceptsReturn="True" MinHeight="70" TextWrapping="NoWrap" VerticalContentAlignment="Top"
                                 AutomationProperties.Name="URLs de webhook" />
                        <CheckBox Content="Notificar também avisos preventivos (desgaste de peças)" IsChecked="{Binding Settings.NotifyWarnings}" Margin="0,10,0,0" />
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="Envio somente por HTTPS (TLS 1.2/1.3). Alertas críticos são enviados logo após a varredura que os confirmou; falhas são reenviadas a cada minuto." />
                        <Button Content="Enviar webhook de teste" Command="{Binding TestWebhookCommand}" HorizontalAlignment="Left" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <!-- Backup -->
                <Border Style="{StaticResource Card}" Width="420" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="Backup e restauração" Style="{StaticResource SectionTitle}" />
                        <CheckBox Content="Backup automático diário" IsChecked="{Binding Settings.BackupEnabled}" />
                        <TextBlock Text="Pasta de backups (vazio = pasta padrão)" Style="{StaticResource FieldLabel}" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Procurar…" Command="{Binding BrowseBackupDirCommand}" Margin="8,0,0,0" />
                            <TextBox Text="{Binding Settings.BackupDirectory}" AutomationProperties.Name="Pasta de backups" />
                        </DockPanel>
                        <TextBlock Text="Manter backups por (dias)" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Settings.BackupRetentionDays}" AutomationProperties.Name="Retenção de backups em dias" />
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="Recomendado: aponte para uma pasta de rede ou unidade externa para recuperação em caso de perda da máquina." />
                        <WrapPanel Margin="0,10,0,0">
                            <Button Content="Fazer backup agora" Command="{Binding BackupNowCommand}" />
                            <Button Content="Restaurar backup…" Command="{Binding RestoreCommand}" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Pasta de dados" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Abrir" Command="{Binding OpenDataFolderCommand}" Margin="8,0,0,0" />
                            <TextBox Text="{Binding DataDirectory, Mode=OneWay}" IsReadOnly="True" AutomationProperties.Name="Pasta de dados" />
                        </DockPanel>
                    </StackPanel>
                </Border>
            </WrapPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
