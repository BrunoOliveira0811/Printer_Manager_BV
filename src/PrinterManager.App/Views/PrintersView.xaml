<UserControl x:Class="PrinterManager.App.Views.PrintersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <!-- Filtros (RF15) -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,10" Padding="12">
            <WrapPanel>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Buscar (nome, IP, série, local)" Style="{StaticResource Muted}" />
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="240" AutomationProperties.Name="Buscar impressora" />
                </StackPanel>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Status" Style="{StaticResource Muted}" />
                    <ComboBox ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatus}" Width="130" AutomationProperties.Name="Filtrar por status" />
                </StackPanel>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Situação" Style="{StaticResource Muted}" />
                    <ComboBox ItemsSource="{Binding LifecycleOptions}" SelectedItem="{Binding SelectedLifecycle}" Width="120" AutomationProperties.Name="Filtrar por situação" />
                </StackPanel>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Setor" Style="{StaticResource Muted}" />
                    <ComboBox ItemsSource="{Binding SectorOptions}" SelectedItem="{Binding SelectedSector}" Width="160" AutomationProperties.Name="Filtrar por setor" />
                </StackPanel>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Modelo" Style="{StaticResource Muted}" />
                    <ComboBox ItemsSource="{Binding ModelOptions}" SelectedItem="{Binding SelectedModel}" Width="200" AutomationProperties.Name="Filtrar por modelo" />
                </StackPanel>
                <Button Content="Limpar filtros" Command="{Binding ClearFiltersCommand}" VerticalAlignment="Bottom" />
            </WrapPanel>
        </Border>

        <!-- Ações -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
            <WrapPanel>
                <Button Content="Nova impressora" Command="{Binding AddCommand}" Style="{StaticResource PrimaryButton}" />
                <Button Content="Editar" Command="{Binding EditCommand}" />
                <Button Content="Detalhes" Command="{Binding DetailsCommand}" />
                <Button Content="Atualizar selecionada" Command="{Binding PollSelectedCommand}" />
                <Button Content="Excluir" Command="{Binding DeleteCommand}" />
            </WrapPanel>
        </DockPanel>

        <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" MouseDoubleClick="Grid_MouseDoubleClick"
                  AutomationProperties.Name="Lista de impressoras">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Status" Width="110" SortMemberPath="Status">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ContentPresenter Content="{Binding Status}" ContentTemplate="{StaticResource StatusPill}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="2*" MinWidth="170" />
                <DataGridTextColumn Header="IP" Binding="{Binding IpAddress}" Width="110" />
                <DataGridTextColumn Header="Setor" Binding="{Binding Sector}" Width="*" MinWidth="100" />
                <DataGridTextColumn Header="Modelo" Binding="{Binding Model}" Width="2*" MinWidth="160" />
                <DataGridTextColumn Header="Local" Binding="{Binding Location}" Width="*" MinWidth="90" />
                <DataGridTextColumn Header="Suprimentos" Binding="{Binding SupplySummary}" Width="190" FontFamily="Consolas" />
                <DataGridTextColumn Header="Contador" Binding="{Binding TotalPages, StringFormat=N0}" Width="90" />
                <DataGridTextColumn Header="Situação" Binding="{Binding Lifecycle, Converter={StaticResource EnumDescription}}" Width="85" />
                <DataGridTextColumn Header="SNMP" Binding="{Binding Snmp}" Width="75" />
                <DataGridTextColumn Header="Última leitura" Binding="{Binding LastSuccessAt, Converter={StaticResource UtcToLocal}}" Width="120" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
