<UserControl x:Class="PrinterManager.App.Views.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <Button Content="Novo usuário" Command="{Binding AddCommand}" Style="{StaticResource PrimaryButton}" />
            <Button Content="Editar" Command="{Binding EditCommand}" />
            <Button Content="Redefinir senha" Command="{Binding ResetPasswordCommand}" />
            <Button Content="Desbloquear" Command="{Binding UnlockCommand}" />
        </WrapPanel>
        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap"
                   Text="Senhas armazenadas com bcrypt. O usuário é bloqueado por 15 minutos após 5 tentativas consecutivas incorretas." />
        <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" AutomationProperties.Name="Usuários">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50" />
                <DataGridTextColumn Header="Login" Binding="{Binding UserName}" Width="140" />
                <DataGridTextColumn Header="Nome" Binding="{Binding FullName}" Width="*" />
                <DataGridTextColumn Header="E-mail" Binding="{Binding Email}" Width="*" />
                <DataGridTextColumn Header="Perfil" Binding="{Binding Role, Converter={StaticResource EnumDescription}}" Width="120" />
                <DataGridTextColumn Header="Ativo" Binding="{Binding IsActive}" Width="60" />
                <DataGridTextColumn Header="Bloqueado até" Binding="{Binding LockoutUntil, Converter={StaticResource UtcToLocal}}" Width="120" />
                <DataGridTextColumn Header="Último acesso" Binding="{Binding LastLoginAt, Converter={StaticResource UtcToLocal}}" Width="120" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
