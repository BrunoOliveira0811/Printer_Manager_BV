<Window x:Class="PrinterManager.App.Views.PrinterDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Header}" Style="{StaticResource AppWindow}"
        Width="1080" Height="760" MinWidth="720" MinHeight="500"
        WindowStartupLocation="CenterOwner" Icon="/Resources/app.png">
    <DockPanel Margin="20">
        <!-- Cabeçalho -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <TextBlock Text="{Binding BusyText}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Button Content="Atualizar agora" Command="{Binding PollNowCommand}" Style="{StaticResource PrimaryButton}" />
                    <Button Content="Editar cadastro" Command="{Binding EditCommand}" Margin="0" />
                </StackPanel>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Printer.Name}" FontSize="18" FontWeight="SemiBold" Margin="0,0,12,0" />
                        <ContentPresenter Content="{Binding Printer.Status}" ContentTemplate="{StaticResource StatusPill}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap">
                        <Run Text="{Binding Printer.IpAddress, Mode=OneWay}" /> · <Run Text="{Binding Printer.Sector, Mode=OneWay}" /> ·
                        <Run Text="{Binding Printer.Model, Mode=OneWay}" /> · Série <Run Text="{Binding Printer.SerialNumber, Mode=OneWay}" />
                    </TextBlock>
                    <WrapPanel Margin="0,8,0,0">
                        <TextBlock Margin="0,0,24,0">Total: <Run FontWeight="SemiBold" Text="{Binding Printer.TotalPages, StringFormat=N0, Mode=OneWay}" /></TextBlock>
                        <TextBlock Margin="0,0,24,0">Mono: <Run FontWeight="SemiBold" Text="{Binding Printer.MonoPages, StringFormat=N0, Mode=OneWay}" /></TextBlock>
                        <TextBlock Margin="0,0,24,0">Cor: <Run FontWeight="SemiBold" Text="{Binding Printer.ColorPages, StringFormat=N0, Mode=OneWay}" /></TextBlock>
                        <TextBlock Margin="0,0,24,0">Estado: <Run Text="{Binding Printer.DeviceStatusText, Mode=OneWay}" /></TextBlock>
                        <TextBlock Margin="0,0,24,0">Última leitura: <Run Text="{Binding Printer.LastSuccessAt, Converter={StaticResource UtcToLocal}, Mode=OneWay}" /></TextBlock>
                    </WrapPanel>
                    <TextBlock Margin="0,4,0,0" Visibility="{Binding Printer.PanelMessage, Converter={StaticResource NullToCollapsed}}">
                        Painel: <Run FontFamily="Consolas" Text="{Binding Printer.PanelMessage, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Margin="0,4,0,0" Foreground="{StaticResource StatusError}" TextWrapping="Wrap"
                               Visibility="{Binding Printer.LastError, Converter={StaticResource NullToCollapsed}}"
                               Text="{Binding Printer.LastError}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <TabControl>
            <!-- RF03 / RF04 -->
            <TabItem Header="Suprimentos e peças">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <TextBlock Text="Toner / tinta" Style="{StaticResource SectionTitle}" />
                        <ItemsControl ItemsSource="{Binding Consumables}" ItemTemplate="{StaticResource SupplyBar}" HorizontalAlignment="Left" Width="560" />
                        <TextBlock Text="Nenhum nível de toner/tinta informado pelo equipamento." Style="{StaticResource Muted}"
                                   Visibility="{Binding HasNoConsumables, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="Outros itens reportados pelo equipamento (vida restante)" Style="{StaticResource SectionTitle}" Margin="0,16,0,8" />
                        <ItemsControl ItemsSource="{Binding OtherSupplies}" ItemTemplate="{StaticResource SupplyBar}" Width="560" HorizontalAlignment="Left" />
                        <TextBlock Text="Nenhum outro item informado." Style="{StaticResource Muted}"
                                   Visibility="{Binding HasNoOtherSupplies, Converter={StaticResource BoolToVisibility}}" />

                        <DockPanel Margin="0,20,0,8">
                            <Button DockPanel.Dock="Right" Content="Adicionar peça" Command="{Binding AddPartCommand}" Margin="0" />
                            <StackPanel>
                                <TextBlock Text="Peças de desgaste controladas" Style="{StaticResource SectionTitle}" Margin="0" />
                                <TextBlock Style="{StaticResource Muted}" Text="Desgaste = páginas desde a última troca ÷ vida útil nominal do fabricante." />
                            </StackPanel>
                        </DockPanel>
                        <DataGrid ItemsSource="{Binding WearParts}" MaxHeight="320" AutomationProperties.Name="Peças de desgaste">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Peça" Binding="{Binding Name}" Width="2*" />
                                <DataGridTemplateColumn Header="Desgaste" Width="2*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <ProgressBar Value="{Binding BarPercent, Mode=OneWay}" Maximum="100" Height="12">
                                                    <ProgressBar.Style>
                                                        <Style TargetType="ProgressBar">
                                                            <Setter Property="Foreground" Value="{StaticResource StatusOnline}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding NeedsReplacement}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource StatusError}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ProgressBar.Style>
                                                </ProgressBar>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="%" Binding="{Binding WearText}" Width="*" />
                                <DataGridTextColumn Header="Páginas desde a troca" Binding="{Binding UsedPages, StringFormat=N0}" Width="*" />
                                <DataGridTextColumn Header="Vida nominal" Binding="{Binding NominalLife, StringFormat=N0}" Width="*" />
                                <DataGridTextColumn Header="Situação" Binding="{Binding Status}" Width="*" />
                                <DataGridTextColumn Header="Última troca" Binding="{Binding LastResetAt, Converter={StaticResource UtcToLocal}}" Width="*" />
                                <DataGridTemplateColumn Header="Ações" Width="190">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="Editar" Padding="8,2" MinHeight="24"
                                                        Command="{Binding DataContext.EditPartCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                <Button Content="Trocar / resetar" Padding="8,2" MinHeight="24" Margin="0"
                                                        Command="{Binding DataContext.ResetPartCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- RF14 -->
            <TabItem Header="Erros e eventos do firmware">
                <DataGrid ItemsSource="{Binding Events}" Margin="12" AutomationProperties.Name="Eventos do firmware">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Ativo" Binding="{Binding IsActive}" Width="60" />
                        <DataGridTemplateColumn Header="Severidade" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Severity, Converter={StaticResource EnumDescription}}" Foreground="{Binding Severity, Converter={StaticResource SeverityToBrush}}" FontWeight="SemiBold" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Código" Binding="{Binding Code}" Width="130" />
                        <DataGridTextColumn Header="Descrição" Binding="{Binding Description}" Width="3*" />
                        <DataGridTextColumn Header="Origem" Binding="{Binding Source}" Width="*" />
                        <DataGridTextColumn Header="Primeira ocorrência" Binding="{Binding FirstSeenAt, Converter={StaticResource UtcToLocal}}" Width="130" />
                        <DataGridTextColumn Header="Última ocorrência" Binding="{Binding LastSeenAt, Converter={StaticResource UtcToLocal}}" Width="130" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- RF05 -->
            <TabItem Header="Histórico de contadores">
                <DataGrid ItemsSource="{Binding Counters}" Margin="12" AutomationProperties.Name="Histórico de contadores">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Data" Binding="{Binding Timestamp, Converter={StaticResource UtcToLocal}}" Width="150" />
                        <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=N0}" Width="*" />
                        <DataGridTextColumn Header="Mono" Binding="{Binding Mono, StringFormat=N0}" Width="*" />
                        <DataGridTextColumn Header="Cor" Binding="{Binding Color, StringFormat=N0}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- RF10 -->
            <TabItem Header="Manutenções">
                <DockPanel Margin="12">
                    <Button DockPanel.Dock="Top" HorizontalAlignment="Left" Content="Registrar manutenção" Command="{Binding AddMaintenanceCommand}" Margin="0,0,0,8" />
                    <DataGrid ItemsSource="{Binding Maintenance}" AutomationProperties.Name="Manutenções">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Data" Binding="{Binding PerformedAt, Converter={StaticResource UtcToLocal}}" Width="130" />
                            <DataGridTextColumn Header="Tipo" Binding="{Binding Type, Converter={StaticResource EnumDescription}}" Width="160" />
                            <DataGridTextColumn Header="Peça" Binding="{Binding PartName}" Width="*" />
                            <DataGridTextColumn Header="Descrição" Binding="{Binding Description}" Width="3*" />
                            <DataGridTextColumn Header="Contador" Binding="{Binding CounterAtService, StringFormat=N0}" Width="90" />
                            <DataGridTextColumn Header="Responsável" Binding="{Binding UserName}" Width="110" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Alertas">
                <DataGrid ItemsSource="{Binding Alerts}" Margin="12" AutomationProperties.Name="Alertas da impressora">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Severidade" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Severity, Converter={StaticResource EnumDescription}}" Foreground="{Binding Severity, Converter={StaticResource SeverityToBrush}}" FontWeight="SemiBold" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Tipo" Binding="{Binding Type, Converter={StaticResource EnumDescription}}" Width="140" />
                        <DataGridTextColumn Header="Mensagem" Binding="{Binding Message}" Width="3*" />
                        <DataGridTextColumn Header="Aberto em" Binding="{Binding CreatedAt, Converter={StaticResource UtcToLocal}}" Width="120" />
                        <DataGridTextColumn Header="Resolvido em" Binding="{Binding ResolvedAt, Converter={StaticResource UtcToLocal}}" Width="120" />
                        <DataGridTextColumn Header="Notificado em" Binding="{Binding NotifiedAt, Converter={StaticResource UtcToLocal}}" Width="120" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
