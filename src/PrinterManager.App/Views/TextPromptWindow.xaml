<Window x:Class="PrinterManager.App.Views.TextPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}"
        Width="440" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="20">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,0,0,8" />
        <TextBox x:Name="InputBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" VerticalContentAlignment="Top" />
        <PasswordBox x:Name="PasswordInput" Visibility="Collapsed" />
        <PasswordBox x:Name="PasswordConfirm" Visibility="Collapsed" Margin="0,8,0,0" ToolTip="Confirme a senha" />
        <TextBlock x:Name="ErrorText" Foreground="{StaticResource StatusError}" Margin="0,6,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancelar" IsCancel="True" />
            <Button Content="Confirmar" IsDefault="True" Style="{StaticResource PrimaryButton}" Margin="0" Click="Ok_Click" />
        </StackPanel>
    </StackPanel>
</Window>
