<UserControl x:Class="PrinterManager.App.Views.AuditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="Texto" Style="{StaticResource Muted}" />
                <TextBox Text="{Binding SearchText}" Width="220" AutomationProperties.Name="Buscar na auditoria" />
            </StackPanel>
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="De" Style="{StaticResource Muted}" />
                <DatePicker SelectedDate="{Binding From}" Width="130" AutomationProperties.Name="Data inicial" />
            </StackPanel>
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="Até" Style="{StaticResource Muted}" />
                <DatePicker SelectedDate="{Binding To}" Width="130" AutomationProperties.Name="Data final" />
            </StackPanel>
            <Button Content="Filtrar" Command="{Binding RefreshCommand}" VerticalAlignment="Bottom" />
            <Button Content="Verificar integridade" Command="{Binding VerifyCommand}" VerticalAlignment="Bottom" />
        </WrapPanel>
        <TextBlock DockPanel.Dock="Top" Text="{Binding Integrity}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,8"
                   AutomationProperties.LiveSetting="Polite" Visibility="{Binding Integrity, Converter={StaticResource NullToCollapsed}}" />
        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap"
                   Text="Registros imutáveis (alteração e exclusão bloqueadas no banco) e encadeados por hash SHA-256. Não há expurgo automático." />
        <DataGrid ItemsSource="{Binding Items}" AutomationProperties.Name="Registros de auditoria">
            <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="60" />
                <DataGridTextColumn Header="Data" Binding="{Binding Timestamp, Converter={StaticResource UtcToLocal}, ConverterParameter=dd/MM/yyyy HH:mm:ss}" Width="140" />
                <DataGridTextColumn Header="Usuário" Binding="{Binding UserName}" Width="110" />
                <DataGridTextColumn Header="ID usuário" Binding="{Binding UserId}" Width="75" />
                <DataGridTextColumn Header="Ação" Binding="{Binding Action}" Width="180" />
                <DataGridTextColumn Header="Entidade" Binding="{Binding Entity}" Width="110" />
                <DataGridTextColumn Header="ID" Binding="{Binding EntityId}" Width="80" />
                <DataGridTextColumn Header="Detalhes" Binding="{Binding Details}" Width="3*" MinWidth="300" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
