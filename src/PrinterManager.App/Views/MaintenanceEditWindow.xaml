<Window x:Class="PrinterManager.App.Views.MaintenanceEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Registrar manutenção" Style="{StaticResource AppWindow}"
        Width="460" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="20">
        <TextBlock Text="Data do serviço" Style="{StaticResource FieldLabel}" />
        <DatePicker x:Name="DateBox" AutomationProperties.Name="Data do serviço" />
        <TextBlock Text="Tipo" Style="{StaticResource FieldLabel}" />
        <ComboBox x:Name="TypeBox" DisplayMemberPath="Text" SelectedValuePath="Value" AutomationProperties.Name="Tipo de manutenção" />
        <TextBlock Text="Peça / suprimento (opcional)" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="PartBox" AutomationProperties.Name="Peça ou suprimento" />
        <TextBlock Text="Contador no momento do serviço" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="CounterBox" AutomationProperties.Name="Contador no momento do serviço" />
        <TextBlock Text="Descrição do serviço *" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="DescriptionBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" VerticalContentAlignment="Top"
                 AutomationProperties.Name="Descrição do serviço" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancelar" IsCancel="True" />
            <Button Content="Salvar" Style="{StaticResource PrimaryButton}" Margin="0" Click="Save_Click" />
        </StackPanel>
    </StackPanel>
</Window>
