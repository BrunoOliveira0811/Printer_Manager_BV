<Window x:Class="PrinterManager.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PrinterManager.App.ViewModels"
        xmlns:v="clr-namespace:PrinterManager.App.Views"
        Title="Gestão de Impressoras"
        Icon="/Resources/app.png"
        Style="{StaticResource AppWindow}"
        Width="1360" Height="840" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><v:DashboardView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:PrintersViewModel}"><v:PrintersView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DiscoveryViewModel}"><v:DiscoveryView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AlertsViewModel}"><v:AlertsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:MaintenanceViewModel}"><v:MaintenanceView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportsViewModel}"><v:ReportsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AuditViewModel}"><v:AuditView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:UsersViewModel}"><v:UsersView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><v:SettingsView /></DataTemplate>

        <Style x:Key="NavItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource NavFg}" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}" Margin="8,1" CornerRadius="4">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource NavHoverBg}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource NavSelectedBg}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="White" />
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Navegação -->
        <DockPanel Background="{StaticResource NavBg}">
            <StackPanel DockPanel.Dock="Top" Margin="18,20,18,18" Orientation="Horizontal">
                <Image Source="/Resources/app.png" Width="32" Height="32" Margin="0,0,10,0" AutomationProperties.Name="Logotipo" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Gestão de" Foreground="{StaticResource NavFg}" FontSize="12" />
                    <TextBlock Text="Impressoras" Foreground="White" FontSize="16" FontWeight="SemiBold" />
                </StackPanel>
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Margin="18,12,18,18">
                <TextBlock Text="{Binding UserDisplay}" Foreground="White" TextWrapping="Wrap" Margin="0,0,0,8" />
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource LinkButton}" Content="Trocar senha" Command="{Binding ChangePasswordCommand}" Margin="0,0,14,0" />
                    <Button Style="{StaticResource LinkButton}" Content="Sair" Command="{Binding LogoutCommand}" />
                </StackPanel>
            </StackPanel>

            <ListBox ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNav}" Background="Transparent" BorderThickness="0"
                     ItemContainerStyle="{StaticResource NavItemStyle}" AutomationProperties.Name="Menu principal">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="26" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Title}" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Conteúdo -->
        <DockPanel Grid.Column="1">
            <Border DockPanel.Dock="Top" Background="{StaticResource CardBg}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,0,1" Padding="24,12">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding PollingStatus}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Button Content="Atualizar todas agora" Command="{Binding RefreshAllCommand}" Style="{StaticResource PrimaryButton}" Margin="0"
                                ToolTip="Consulta imediatamente todas as impressoras ativas via SNMP" />
                    </StackPanel>
                    <TextBlock Text="{Binding CurrentPage.Title}" Style="{StaticResource PageTitle}" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <!-- Faixa de alerta crítico (RF07) -->
            <Border x:Name="AlertBanner" DockPanel.Dock="Top" Background="{StaticResource CriticalBg}" BorderBrush="{StaticResource CriticalBorder}"
                    BorderThickness="0,0,0,1" Padding="24,8"
                    Visibility="{Binding HasCriticalAlerts, Converter={StaticResource BoolToVisibility}}"
                    AutomationProperties.LiveSetting="Assertive" AutomationProperties.Name="Alertas críticos ativos">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Ver alertas" Command="{Binding GoToAlertsCommand}" Margin="0" />
                    <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{StaticResource StatusError}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{StaticResource StatusError}">
                        <Run Text="{Binding CriticalAlertCount, Mode=OneWay}" FontWeight="Bold" />
                        <Run Text="alerta(s) crítico(s) ativo(s)." FontWeight="Bold" />
                        <Run Text="{Binding LatestCriticalMessage, Mode=OneWay}" />
                    </TextBlock>
                </DockPanel>
            </Border>

            <ContentControl Content="{Binding CurrentPage}" Margin="24,16,24,16" Focusable="False" />
        </DockPanel>
    </Grid>
</Window>
