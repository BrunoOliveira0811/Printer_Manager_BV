<UserControl x:Class="PrinterManager.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="KpiCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="MinWidth" Value="150" />
        </Style>
        <Style x:Key="KpiValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!-- Indicadores -->
        <WrapPanel DockPanel.Dock="Top">
            <Border Style="{StaticResource KpiCard}" AutomationProperties.Name="Impressoras monitoradas">
                <StackPanel>
                    <TextBlock Text="Monitoradas" Style="{StaticResource Muted}" />
                    <TextBlock Text="{Binding Total}" Style="{StaticResource KpiValue}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource KpiCard}">
                <StackPanel>
                    <TextBlock Text="Respondendo" Style="{StaticResource Muted}" />
                    <TextBlock Text="{Binding Online}" Style="{StaticResource KpiValue}" Foreground="{StaticResource StatusOnline}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource KpiCard}">
                <StackPanel>
                    <TextBlock Text="Offline" Style="{StaticResource Muted}" />
                    <TextBlock Text="{Binding Offline}" Style="{StaticResource KpiValue}" Foreground="{StaticResource StatusOffline}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource KpiCard}">
                <StackPanel>
                    <TextBlock Text="Com alertas" Style="{StaticResource Muted}" />
                    <TextBlock Text="{Binding WithAlerts}" Style="{StaticResource KpiValue}" Foreground="{StaticResource StatusAlert}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource KpiCard}">
                <StackPanel>
                    <TextBlock Text="Alertas críticos" Style="{StaticResource Muted}" />
                    <TextBlock Text="{Binding Shell.CriticalAlertCount}" Style="{StaticResource KpiValue}" Foreground="{StaticResource StatusError}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource KpiCard}" ToolTip="Impressoras ativas (inativas e descartadas não são contabilizadas)">
                <StackPanel>
                    <TextBlock Text="Licenças em uso" Style="{StaticResource Muted}" />
                    <TextBlock Text="{Binding Licensed}" Style="{StaticResource KpiValue}" />
                </StackPanel>
            </Border>
        </WrapPanel>

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <TextBlock Text="Setor:" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox ItemsSource="{Binding Sectors}" SelectedItem="{Binding SectorFilter}" Width="200" AutomationProperties.Name="Filtrar por setor" />
                <Button Content="Recarregar" Command="{Binding RefreshCommand}" Margin="8,0,0,0" />
            </StackPanel>
            <TextBlock Text="Clique em uma impressora para ver detalhes" Style="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </DockPanel>

        <!-- Cartões de saúde -->
        <Grid>
            <TextBlock Text="Nenhuma impressora ativa. Cadastre em &quot;Impressoras&quot; ou use a &quot;Descoberta na rede&quot;."
                       FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Cards.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                <ItemsControl ItemsSource="{Binding Cards}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.OpenPrinterCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}" Width="300" Margin="0,0,12,12" Padding="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top"
                                    Background="{StaticResource CardBg}" BorderBrush="{StaticResource PanelBorder}"
                                    AutomationProperties.Name="{Binding AccessibleName}">
                                <StackPanel Margin="14" Width="270">
                                    <DockPanel>
                                        <ContentPresenter DockPanel.Dock="Right" Content="{Binding Status}" ContentTemplate="{StaticResource StatusPill}" />
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,2,0,8">
                                        <Run Text="{Binding IpAddress, Mode=OneWay}" /> · <Run Text="{Binding Sector, Mode=OneWay}" />
                                    </TextBlock>

                                    <ItemsControl ItemsSource="{Binding Supplies}" ItemTemplate="{StaticResource SupplyBar}" Focusable="False" />
                                    <TextBlock Text="Sem dados de suprimentos" Style="{StaticResource Muted}"
                                               Visibility="{Binding HasNoSupplies, Converter={StaticResource BoolToVisibility}}" />

                                    <TextBlock Text="{Binding WorstWear}" Margin="0,6,0,0" Style="{StaticResource Muted}"
                                               Visibility="{Binding WorstWear, Converter={StaticResource NullToCollapsed}}">
                                    </TextBlock>
                                    <TextBlock Text="⚠ Troca de peça recomendada" Foreground="{StaticResource StatusAlert}" FontWeight="SemiBold"
                                               Visibility="{Binding WearWarning, Converter={StaticResource BoolToVisibility}}" />

                                    <DockPanel Margin="0,8,0,0">
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Muted}" Text="{Binding Counter}" />
                                        <TextBlock Style="{StaticResource Muted}" Text="{Binding LastPoll}" />
                                    </DockPanel>
                                    <TextBlock Foreground="{StaticResource StatusError}" FontWeight="SemiBold" Margin="0,4,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding AlertCount}" Value="0">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                        <Run Text="{Binding AlertCount, Mode=OneWay}" /> alerta(s) ativo(s)
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
