<Window x:Class="PrinterManager.App.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestão de Impressoras - Entrar"
        Icon="/Resources/app.png"
        Style="{StaticResource AppWindow}"
        Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FocusManager.FocusedElement="{Binding ElementName=UserNameBox}">
    <Border Style="{StaticResource Card}" Margin="16" Padding="24">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Image Source="/Resources/app.png" Width="40" Height="40" Margin="0,0,12,0" AutomationProperties.Name="Logotipo" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Gestão de Impressoras" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="Monitoramento de suprimentos e peças" Style="{StaticResource Muted}" />
                </StackPanel>
            </StackPanel>

            <!-- Primeiro acesso: criação do administrador -->
            <StackPanel x:Name="SetupPanel" Visibility="Collapsed">
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                           Text="Primeiro acesso: crie o usuário Administrador do sistema." />
                <TextBlock Text="Nome completo" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="FullNameBox" AutomationProperties.Name="Nome completo" />
            </StackPanel>

            <TextBlock Text="Usuário" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="UserNameBox" AutomationProperties.Name="Usuário" />

            <TextBlock Text="Senha" Style="{StaticResource FieldLabel}" />
            <PasswordBox x:Name="PasswordBox" AutomationProperties.Name="Senha" />

            <StackPanel x:Name="ConfirmPanel" Visibility="Collapsed">
                <TextBlock Text="Confirmar senha" Style="{StaticResource FieldLabel}" />
                <PasswordBox x:Name="ConfirmBox" AutomationProperties.Name="Confirmar senha" />
                <TextBlock Text="Mínimo de 8 caracteres, com letras e números." Style="{StaticResource Muted}" Margin="0,4,0,0" />
            </StackPanel>

            <TextBlock x:Name="ErrorText" Foreground="{StaticResource StatusError}" TextWrapping="Wrap" Margin="0,12,0,0"
                       Visibility="Collapsed" AutomationProperties.LiveSetting="Assertive" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Cancelar" IsCancel="True" Click="Cancel_Click" />
                <Button x:Name="LoginButton" Content="Entrar" IsDefault="True" Style="{StaticResource PrimaryButton}" Margin="0" Click="Login_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
