<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Mesma paleta do Utilitário de Impressoras (tema claro) -->
    <SolidColorBrush x:Key="AppBg"               Color="#E9EDF2"/>
    <SolidColorBrush x:Key="PanelBg"             Color="#F7F9FB"/>
    <SolidColorBrush x:Key="PanelBorder"         Color="#C8D1DB"/>
    <SolidColorBrush x:Key="CardBg"              Color="#FFFFFF"/>
    <SolidColorBrush x:Key="NavBg"               Color="#1F2A37"/>
    <SolidColorBrush x:Key="NavFg"               Color="#D5DEE8"/>
    <SolidColorBrush x:Key="NavSelectedBg"       Color="#2B77D1"/>
    <SolidColorBrush x:Key="NavHoverBg"          Color="#2C3A4B"/>
    <SolidColorBrush x:Key="TextPrimary"         Color="#22303B"/>
    <SolidColorBrush x:Key="TextSecondary"       Color="#56626E"/>
    <SolidColorBrush x:Key="Accent"              Color="#2B77D1"/>
    <SolidColorBrush x:Key="ButtonBg"            Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ButtonBorder"        Color="#C7D0DA"/>
    <SolidColorBrush x:Key="ButtonFg"            Color="#25313C"/>
    <SolidColorBrush x:Key="PrimaryButtonBg"     Color="#2B77D1"/>
    <SolidColorBrush x:Key="PrimaryButtonBorder" Color="#2365B4"/>
    <SolidColorBrush x:Key="DangerButtonBg"      Color="#C62828"/>
    <SolidColorBrush x:Key="InputBorder"         Color="#9AA7B5"/>
    <SolidColorBrush x:Key="GridHeaderBg"        Color="#F1F4F7"/>
    <SolidColorBrush x:Key="GridAltRowBg"        Color="#F8FAFC"/>
    <SolidColorBrush x:Key="GridHLine"           Color="#E4E9EF"/>

    <!-- Estados (sempre acompanhados de texto — não dependem só da cor) -->
    <SolidColorBrush x:Key="StatusOnline"   Color="#2E7D32"/>
    <SolidColorBrush x:Key="StatusAlert"    Color="#B45309"/>
    <SolidColorBrush x:Key="StatusError"    Color="#C62828"/>
    <SolidColorBrush x:Key="StatusOffline"  Color="#4B5563"/>
    <SolidColorBrush x:Key="StatusUnknown"  Color="#78909C"/>
    <SolidColorBrush x:Key="CriticalBg"     Color="#FDECEA"/>
    <SolidColorBrush x:Key="CriticalBorder" Color="#E57373"/>
    <SolidColorBrush x:Key="WarningBg"      Color="#FFF4E5"/>

    <!-- Cores de suprimentos -->
    <SolidColorBrush x:Key="SupplyBlack"   Color="#263238"/>
    <SolidColorBrush x:Key="SupplyCyan"    Color="#0097C7"/>
    <SolidColorBrush x:Key="SupplyMagenta" Color="#C2185B"/>
    <SolidColorBrush x:Key="SupplyYellow"  Color="#E0B000"/>
    <SolidColorBrush x:Key="SupplyOther"   Color="#7E8B99"/>
    <SolidColorBrush x:Key="BarTrack"      Color="#E3E8EE"/>

</ResourceDictionary>
